# Copy this file to Backend/.env and replace the placeholder locally.
# Never commit Backend/.env or paste its value into chat, source, logs,
# screenshots, frontend VITE_ variables, or request URLs.
STEAM_WEB_API_KEY=replace-with-your-steam-web-api-key

# Explicit store context for later enrichment; this is not inferred from the
# Steam account and does not contain a secret.
STEAM_STORE_COUNTRY=US
STEAM_STORE_LANGUAGE=english
