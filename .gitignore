# Local secrets and credentials (examples must contain placeholders only)
.env
.env.*
.envrc
!.env.example
!.env.*.example
# Backend secrets are intentionally explicit as well as covered by the rules above.
/Backend/.env
/Backend/.env.*
!/Backend/.env.example
!/Backend/.env.*.example
.npmrc
.pypirc
.netrc
_netrc
.python-version.local
secrets/
.aws/
.ssh/
*.pem
*.key
*.p12
*.pfx

# React, Vite and Node dependencies/generated output
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Python environments, bytecode, tool caches and package output
.venv/
.venv*/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
pytest-cache-files-*/
.ruff_cache/
.mypy_cache/
.pytype/
.hypothesis/
.tox/
.nox/
*.egg-info/
.eggs/
pip-wheel-metadata/
__pypackages__/
.ipynb_checkpoints/

# Test reports and generated coverage
coverage/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml
test-results/
playwright-report/

# Local Steam imports, caches, exports and account-specific plots
# Keep source datasets and synthetic Data/fixtures/ eligible for Git.
/Data/raw/
/Data/imports/
/Data/snapshots/
/Data/cache/
/Data/exports/
/Data/plots/
/Backend/data/
/Backend/cache/
/Backend/exports/
/Backend/plots/
/exports/
private-artifacts/
private-fixtures/
backups/
.cache/

